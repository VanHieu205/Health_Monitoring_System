# Copy to .env (gitignored). NEWS2 cut-points stay in algorithms/news2.py.

# --- MQTT ---
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=sensor/raw/#

# --- Shared SQLite ---
SQLITE_PATH=data/local_buffer.db
SENSOR_TABLE=sensor_raw_data

# --- PPG session ---
SETTLE_SECONDS=10
ACQUIRE_SECONDS=50
FUSION_INTERVAL_S=10

# MPU6050 ±16 g (2048 LSB/g). Required so τ_impact = 2.5 g is reachable.
MPU_LSB_PER_G=2048
RMS_PASS_G=0.05
RMS_FAIL_G=0.12

PPG_MAX_IQR_HR_BPM=10
PPG_MAX_IQR_SPO2_PCT=2

# SpO2 quadratic init; replace after fingertip calibration on this hardware.
SPO2_CAL_A=0
SPO2_CAL_B=-15
SPO2_CAL_C=110

TEMP_CORE_OFFSET_C=0.0
TEMP_MIN_SAMPLES=10
TEMP_MAX_IQR_C=0.3

FALL_SMV_IMPACT_G=2.5

# Cold-path FL: SNN, PPG SQI, trend MLP — not NEWS2 tables.
FL_SERVER_HOST=127.0.0.1
FL_SERVER_PORT=50051
FL_ARCHITECTURES=arch.snn,arch.sqi,arch.trend
FL_ONCE=1
